# Django reads environment variables only; this file is a reference.
POC_LOCAL=false
POC_DJANGO_SECRET_KEY=
POC_ALLOWED_HOSTS=oauth-poc.example.com
DJANGO_ISSUER_URL=https://oauth-poc.example.com/
POC_DB_PATH=/data/poc.sqlite3
MCP_PUBLIC_URL=https://calculator-cimd.example.com/mcp
INTROSPECTION_CLIENT_ID=calculator-mcp-service
# Supply only when running create_mcp_service:
INTROSPECTION_CLIENT_SECRET=
# Optional explicit private SNI relay IP, only for chatgpt.com/oauth/client.json:
CIMD_CHATGPT_SNI_PROXY_IP=
