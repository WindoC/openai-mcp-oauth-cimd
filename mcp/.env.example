# MCP settings; load from mcp/.env or environment.
MCP_PUBLIC_URL=https://calculator-cimd.example.com/mcp
DJANGO_ISSUER_URL=https://oauth-poc.example.com/
DJANGO_INTROSPECTION_URL=https://oauth-poc.example.com/mcp-oauth/introspect/
INTROSPECTION_CLIENT_ID=calculator-mcp-service
# Supply a fresh random value through environment / secret manager.
INTROSPECTION_CLIENT_SECRET=
MCP_REQUIRED_SCOPE=calculator:execute
HOST=127.0.0.1
PORT=8001
ALLOW_LOCAL_HTTP=false
INTROSPECTION_TIMEOUT=5
